local function PlayMusic(soundId, skateType)
    pcall(function()
        local RE = ReplicatedStorage:FindFirstChild("RE")
        if not RE then
            MakeNotifi({Title = "❌ خطأ", Text = "لم يتم العثور على RE!", Time = 3})
            return
        end
        local vehicleEvent = RE:FindFirstChild("1NoMoto1rVehicle1s")
        if vehicleEvent then
            vehicleEvent:FireServer(skateType or "SkateBoard")
            task.wait(0.4)
            vehicleEvent:FireServer("PickingScooterMusicText", tostring(soundId))
            MakeNotifi({Title = "🎵 تشغيل", Text = "✅ تم تشغيل الأغنية بنجاح!", Time = 3})
        else
            MakeNotifi({Title = "❌ خطأ", Text = "لم يتم العثور على حدث المركبة!", Time = 3})
        end
    end)
end

