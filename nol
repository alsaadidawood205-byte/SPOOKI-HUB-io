        if #searchText >= 1 then
            for _, p in pairs(Players:GetPlayers()) do
                if p.Name:lower():find(searchText) and p ~= lp then
                    selectedFlingPlayer = p
                    MakeNotifi({Title = "🌀 الفلنق", Text = "✅ تم تحديد: " .. p.Name, Time = 3})
                    return
                end
            end
        end
        selectedFlingPlayer = nil
    end
})

AddToggle(TabFling, {
    Name = "💀 قتل اللاعب بالكنبة",
    Default = false,
    Callback = function(state)
        if state then
            if not selectedFlingPlayer then
                MakeNotifi({Title = "❌ خطأ", Text = "اختر لاعب أولاً!", Time = 3})
                return
            end
            getgenv().flingloop = true
            task.spawn(function()
                while getgenv().flingloop do
                    pcall(function()
                        local target = selectedFlingPlayer
                        if not target or not target.Character then return end
                        local char = lp.Character
                        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                        local rootPart = humanoid and humanoid.RootPart
                        local tChar = target.Character
                        local tHumanoid = tChar:FindFirstChildOfClass("Humanoid")
                        local tRoot = tHumanoid and tHumanoid.RootPart
                        if not rootPart or not tRoot then return end
                        workspace.FallenPartsDestroyHeight = 0/0
                        local BV = Instance.new("BodyVelocity")
                        BV.Name = "SpeedDoPai"
                        BV.Parent = rootPart
                        BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
                        BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                        local angle = 0
                        repeat
                            angle = angle + 100
                            rootPart.CFrame = tRoot.CFrame * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(angle), 0, 0)
                            char:SetPrimaryPartCFrame(tRoot.CFrame * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(angle), 0, 0))
                            rootPart.Velocity = Vector3.new(9e7, 9e7*10, 9e7)
                            task.wait()
                        until tRoot.Velocity.Magnitude > 500 or not getgenv().flingloop
                        BV:Destroy()
                    end)
                    task.wait()
                end
            end)
            MakeNotifi({Title = "🌀 الفلنق", Text = "✅ بدأ الفلنق على: " .. selectedFlingPlayer.Name, Time = 3})
        else
            getgenv().flingloop = false
            MakeNotifi({Title = "🌀 الفلنق", Text = "⏹ تم إيقاف الفلنق!", Time = 3})
        end
    end
})

