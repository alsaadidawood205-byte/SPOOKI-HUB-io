local function resetVel()
    pcall(function()
        if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = lp.Character.HumanoidRootPart
            hrp.Velocity = Vector3.zero
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            if lp.Character:FindFirstChild("Humanoid") then
                lp.Character.Humanoid.Sit = false
            end
        end
    end)
end

-- Heartbeat للمص والاغتصاب
RunService.Heartbeat:Connect(function()
    pcall(function()
        if (faceSitEnabled or bangEnabled) and bangTarget and bangTarget.Character then
            local targetChar = bangTarget.Character
            if not targetChar:FindFirstChild("HumanoidRootPart") then return end
            if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
            
            local hrp = lp.Character.HumanoidRootPart
            local move = math.sin(tick() * 150) * 1.5
            hrp.Velocity = Vector3.zero
            
            if faceSitEnabled and targetChar:FindFirstChild("Head") then
                lp.Character.Humanoid.Sit = true
                hrp.CFrame = targetChar.Head.CFrame * CFrame.new(0, 0.2, -0.5 + move) * CFrame.Angles(0, math.rad(180), 0)
            elseif bangEnabled then
                lp.Character.Humanoid.Sit = false
                hrp.CFrame = targetChar.HumanoidRootPart.CFrame * CFrame.new(0, 0.5, 1.1 + move)
            end
        end
    end)
end)

-- دوال التجسس
local function stopSpy()
    if not spyEnabled then return end
    spyEnabled = false
    pcall(function()
        local camera = workspace.CurrentCamera
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            camera.CameraSubject = lp.Character.Humanoid
        elseif originalCameraSubject then
            camera.CameraSubject = originalCameraSubject
        end
    end)
    spyTarget = nil
end

local function startSpy(target)
    if not target then return end
    if not target.Character or not target.Character:FindFirstChild("Humanoid") then return end
    spyEnabled = true
    spyTarget = target
    pcall(function()
        local camera = workspace.CurrentCamera
        originalCameraSubject = camera.CameraSubject
        camera.CameraSubject = target.Character.Humanoid
    end)
end

-- =============================================
-- دوال الكراسي (TrapChair و MurderChair)
-- =============================================
local function spawnTrapChair(targetPlayerName)
    local targetPlayer = Players:FindFirstChild(targetPlayerName)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local targetPart = targetPlayer.Character.HumanoidRootPart
        local box = Instance.new("Part")
        box.Size = Vector3.new(5, 1, 5)
        box.Position = targetPart.Position + Vector3.new(0, 3, 0)
        box.Anchored = true
        box.Transparency = 1
        box.Parent = Workspace
        
        local chairTemplate = Workspace:FindFirstChild("TrapChair")
        if not chairTemplate then
            warn("❌ لم يتم العثور على TrapChair في Workspace!")
            return
        end
        
        local newChair = chairTemplate:Clone()
        newChair.Position = box.Position + Vector3.new(0, 5, 0)
        newChair.Parent = Workspace
        
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        
        local trapScript = newChair:FindFirstChild("ChairTrapScript")
        if trapScript then
            trapScript.Disabled = false
        end
        
        task.spawn(function()
            while newChair and newChair.Parent and targetPart and targetPlayer.Character and targetPlayer.Character.Humanoid.Health > 0 do
                local direction = (targetPart.Position - newChair.Position).Unit
                bodyVelocity.Velocity = direction * 60
                bodyVelocity.Parent = newChair
                task.wait(0.1)
            end
            if newChair then newChair:Destroy() end
            if box then box:Destroy() end
        end)
    end
end

local function spawnMurderChair(targetPlayerName)
    local targetPlayer = Players:FindFirstChild(targetPlayerName)
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local targetPart = targetPlayer.Character.HumanoidRootPart
        local box = Instance.new("Part")
        box.Size = Vector3.new(5, 1, 5)
        box.Position = targetPart.Position + Vector3.new(0, 3, 0)
        box.Anchored = true
